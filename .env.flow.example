# Chep file nay thanh .env.flow roi dien thong tin that.
# NHO them .env.flow vao .gitignore.

# --- Gmail ---
# FLOW_SMTP_PASS la App Password 16 ky tu, KHONG phai mat khau Gmail.
# Lay tai: myaccount.google.com > Security > 2-Step Verification > App passwords
FLOW_SMTP_USER=ban@gmail.com
FLOW_SMTP_PASS=abcd efgh ijkl mnop
FLOW_NOTIFY_TO=ban@gmail.com

# --- Tuy chon: Telegram (thong bao + bot xem/duyet tu xa: .flow/flow telegram) ---
# Token lay tu @BotFather. Chat id: chay bot roi nhan /id cho no.
# FLOW_TELEGRAM_TOKEN=123456:ABC-DEF
# FLOW_TELEGRAM_CHAT_ID=987654321
# Dung trong nhom: user id duoc phep bam duyet (cach nhau dau phay).
# FLOW_TELEGRAM_APPROVERS=987654321
# Chi cho xem, tat han viec duyet tu xa:
# FLOW_TELEGRAM_READONLY=1

# --- Tuy chon: Slack / Discord webhook ---
# Tu nhan dang theo URL: Slack gui Block Kit, Discord gui embed co mau.
# Nhieu webhook cung luc: cach nhau bang dau phay.
# FLOW_WEBHOOK_URL=https://hooks.slack.com/services/...
# FLOW_WEBHOOK_URL=https://discord.com/api/webhooks/...
# FLOW_WEBHOOK_KIND=slack        # ep kieu neu URL qua proxy: slack | discord | generic

# --- Tuy chon: link dashboard ghi trong thong bao ---
# Mac dinh http://127.0.0.1:<port>, chi mo duoc tren chinh may nay.
# Neu ban mo tunnel (Tailscale, ssh -L...) de duyet tu dien thoai, dat URL do vao day.
# FLOW_DASHBOARD_URL=https://may-cua-ban.ten-tailnet.ts.net

# --- Tuy chon: chi dinh lenh kiem tra ---
# FLOW_TEST_CMD="pnpm test --run"
# FLOW_LINT_CMD="pnpm lint"
# FLOW_TYPECHECK_CMD="tsc --noEmit"
# FLOW_BUILD_CMD="pnpm build"
